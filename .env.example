# MongoDB Atlas: copy the connection string from your cluster's Connect dialog.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Google AI Studio → API keys
GEMINI_API_KEY=your-gemini-api-key
# Google Cloud Console → Places API (New); restrict this key to Places API.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Create a key at https://resend.com/signup and verify your sending domain.
RESEND_API_KEY=re_your-resend-api-key
# Sender address must use a domain verified in Resend.
RESEND_FROM_EMAIL=SiteSeller Agent <hello@your-verified-domain.com>
# Generate a unique random value (at least 32 characters) for signed unsubscribe links.
OUTREACH_SECRET=replace-with-a-long-random-secret
# Workspace login password (at least 16 characters) and signing secret (at least 32 characters).
SITESELLER_ADMIN_PASSWORD=replace-with-a-unique-long-password
SITESELLER_SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Used to authenticate POST /api/replies when connecting an inbound email provider.
REPLY_WEBHOOK_SECRET=replace-with-another-long-random-secret
# Public app URL, no trailing slash, e.g. https://your-app.vercel.app
APP_URL=http://localhost:3000
